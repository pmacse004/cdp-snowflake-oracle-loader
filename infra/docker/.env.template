# =============================================================================
# CDP Snowflake-to-Oracle Loader -- Oracle Docker environment template
# =============================================================================
# INSTRUCTIONS
#   1. Copy this file to infra/docker/.env
#   2. Set ORACLE_PWD to the Oracle container administrator password
#   3. .env is listed in .gitignore and MUST NEVER be committed
#
# IMPORTANT: Docker Compose .env variables are loaded by docker compose only.
#   They are NOT automatically available to a separately launched Maven or
#   Spring Boot process on the host.  The application uses its own separate
#   set of environment variables (see docs/operations/environment-variables.md).
#   In particular, CDP_ORACLE_PASSWORD must be set independently in the host
#   shell or in application-local.yml before running the Spring Boot app.
# =============================================================================

# ---------------------------------------------------------------------------
# ORACLE_PWD
#   Sets the password for SYS, SYSTEM and PDBADMIN in the Oracle container.
#   This is the container admin password -- NOT the CDP_LOADER app password.
#   Minimum: 8 characters, uppercase + lowercase + digit required.
#   Used only by: docker compose / Oracle container initialisation.
#   NOT used by: the Spring Boot application.
# ---------------------------------------------------------------------------
ORACLE_PWD=CHANGE_ME_BEFORE_USE
