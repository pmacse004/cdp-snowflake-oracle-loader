<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.ibm.cdp</groupId>
        <artifactId>cdp-snowflake-oracle-loader</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>cdp-loader-core</artifactId>
    <packaging>jar</packaging>
    <name>CDP Loader — Core Domain</name>
    <description>
        Shared domain model, DTOs, transformation utilities, validation rules
        and reference-data types. No Spring Boot autoconfiguration — plain library.
    </description>

    <dependencies>
        <!-- MapStruct for DTO ↔ domain mapping -->
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
            <version>${mapstruct.version}</version>
        </dependency>

        <!-- Jackson for JSON parsing (rate plan params from Snowflake REF) -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>

        <!-- Validation API -->
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
        </dependency>

        <!-- Bean validation implementation (for unit tests) -->
        <dependency>
            <groupId>org.hibernate.validator</groupId>
            <artifactId>hibernate-validator</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
